{
  "manifest_version": 2,
  "name": "Hatespeech Filter",
  "version": "1.0.9",
  "description": "Hatespeech Filter",
  "permissions": ["storage", "tabs", "http://*/*", "https://*/*", "menus", "scripting"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Hatespeech Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["page_gate.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hatespeech-filter@local"
    }
  }
}
